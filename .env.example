# Database Configuration
MONGO_URI=mongodb://localhost:27017/schoolportal
# or for MongoDB Atlas: MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/schoolportal?retryWrites=true&w=majority

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# Email Configuration (Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# Paystack Configuration
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Optional: Admin Email (for notifications)
ADMIN_EMAIL=admin@schoolportal.com
